# GEMINI_API_KEY: Optional fallback upstream key if routing Gemini models via OpenAI-compatible endpoint.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional default upstream key if callers do not send an Authorization header.
OPENAI_API_KEY=""

# UPSTREAM_BASE_URL: Default OpenAI-compatible upstream API base URL (e.g. https://api.openai.com/v1).
UPSTREAM_BASE_URL="https://api.openai.com/v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
